---
import Base from '../layouts/Base.astro';
import CardArt from '../components/CardArt.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const skills = [
  { name: 'C# / .NET', note: 'APIs, services and business logic, my core stack since 2007', art: 'code' },
  { name: 'Angular & TypeScript', note: 'Rich, maintainable web front ends', art: 'components' },
  { name: 'SQL Server & Oracle', note: 'Data modelling, queries and reporting', art: 'database' },
  { name: 'AI-assisted development', note: 'Claude Code and GitHub Copilot in the daily loop: design, code, review', art: 'ai' },
  { name: 'Leadership & architecture', note: 'Leading teams, Azure DevOps, designing solutions end-to-end', art: 'team' },
] as const;

const projects = [
  {
    name: 'HR & Payroll platforms',
    context: 'Ceridian · SD Worx',
    note: 'Nine years on large-scale Human Resource & payroll software processing pay for thousands of employees, from senior engineer to lead developer of the team.',
    stack: ['C#', 'SQL Server', 'Azure DevOps'],
    art: 'payroll',
  },
  {
    name: 'Government attendance system',
    context: 'Government of Mauritius',
    note: 'Attendance Record Management System rolled out across government bodies. My first big production system, and still a lesson in building for non-technical users.',
    stack: ['C#', 'ASP.NET', 'Oracle'],
    art: 'attendance',
  },
  {
    name: 'Retail point-of-sale suite',
    context: 'Multi-branch retailer',
    note: 'Desktop tills at the counter, a web back office for stock and reporting. One system keeping every branch in sync.',
    stack: ['C#', 'WinForms', 'ASP.NET'],
    art: 'pos',
  },
  {
    name: 'Business web applications',
    context: 'Bioculture Group',
    note: 'The current chapter: modern web applications supporting the operations of a pioneering biosciences group, increasingly built with AI-assisted workflows.',
    stack: ['.NET', 'Angular', 'AI tools'],
    art: 'bio',
  },
] as const;

const aiWorkflow = [
  {
    title: 'Plan & design',
    note: 'Thinking through data models, edge cases and architecture options with an AI pair before a line of code exists.',
  },
  {
    title: 'Build',
    note: 'Claude Code and Copilot in the editor. Boilerplate vanishes, and 18 years of judgement decides what ships.',
  },
  {
    title: 'Review & secure',
    note: 'AI-driven code review and security scanning as a second pair of eyes on every meaningful change.',
  },
] as const;

const journey = [
  {
    period: '2023 - Present',
    role: 'Software Developer',
    org: 'Bioculture Group',
    note: 'Building business web applications for a pioneering biosciences group in Mauritius.',
  },
  {
    period: '2020 - 2023',
    role: 'Lead Software Developer',
    org: 'SD Worx Mauritius',
    note: 'Led development on HR & payroll software; Azure DevOps and team leadership.',
  },
  {
    period: '2017 - 2019',
    role: 'Solution Architect',
    org: 'Cybernaptics Ltd',
    note: 'Designed solutions end-to-end, including mobile applications.',
  },
  {
    period: '2011 - 2017',
    role: 'Senior Software Engineer',
    org: 'Ceridian',
    note: 'Six years on large-scale Human Resource & Payroll platforms (C#, SQL Server).',
  },
  {
    period: '2010 - 2011',
    role: 'Software Engineer',
    org: 'Keysoft',
    note: 'Point-of-sale system for a multi-branch retailer: desktop front end, web back office.',
  },
  {
    period: '2007 - 2010',
    role: 'Software Engineer',
    org: 'Kisoft',
    note: 'Attendance Record Management System for the Government of Mauritius (C#, ASP.NET, Oracle).',
  },
];
---

<Base title="Praveen Kumar Yennam - Software Developer">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Praveen Kumar Yennam',
      jobTitle: 'Software Developer',
      worksFor: { '@type': 'Organization', name: 'Bioculture Group' },
      address: { '@type': 'PostalAddress', addressCountry: 'MU' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Mauritius' },
      email: 'mailto:praveen@bioculture-mauritius.com',
      url: new URL(import.meta.env.BASE_URL, Astro.site).href,
      knowsAbout: ['.NET', 'C#', 'Angular', 'TypeScript', 'SQL Server', 'Oracle', 'AI-assisted software development'],
      sameAs: [
        'https://www.linkedin.com/in/praveen-kumar-yennam-52167910',
        'https://github.com/yennam-praveen',
      ],
    })}
  />
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow reveal">Software developer at Bioculture Group, Mauritius</p>
      <h1 class="hero-title reveal">
        Praveen Kumar<br /><span class="accent-word">Yennam</span>
      </h1>
      <p class="hero-sub reveal reveal-delay-1">
        Eighteen years of business software: HR, payroll, government and
        retail systems, now built with AI in the loop.
      </p>
      <div class="hero-actions reveal reveal-delay-2">
        <a class="btn btn-primary" href={`${base}/ai/`}>How I use AI <span class="btn-icon" aria-hidden="true">↗</span></a>
        <a class="btn btn-ghost" href={`${base}/blog/`}>Read the blog <span class="btn-icon" aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-panel reveal-zoom reveal-delay-2" aria-hidden="true">
        <div class="terminal">
          <div class="terminal-bar">
            <span></span><span></span><span></span>
            <em>praveen@dev: ~</em>
          </div>
          <pre class="terminal-body"><code><span class="line"><i class="t-p">$</i> whoami</span><span class="line t-o">Praveen Kumar Yennam - software developer</span><span class="line"><i class="t-p">$</i> stack <i class="t-f">--list</i></span><span class="line t-o">.NET, Angular, SQL Server, Oracle</span><span class="line"><i class="t-p">$</i> ai <i class="t-f">--status</i></span><span class="line t-o"><i class="t-ok">●</i> claude-code, copilot - active daily</span><span class="line"><i class="t-p">$</i> <i class="caret"></i></span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Career at a glance -->
  <section class="stats-band" aria-label="Career at a glance">
    <dl class="container stats-inner reveal">
      <div><dt>18+</dt><dd>years shipping</dd></div>
      <div><dt>6</dt><dd>companies served</dd></div>
      <div><dt>MBA</dt><dd>IT enterprise mgmt</dd></div>
    </dl>
  </section>

  <!-- About -->
  <section id="about" class="section container">
    <h2 class="section-title reveal">About <span class="accent">me</span></h2>
    <div class="about-grid">
      <p class="reveal-left reveal-delay-1">
        I'm a software developer at Bioculture Group in Mauritius. Over the
        last 18+ years I've worked as an engineer, solution architect and lead
        developer, building HR &amp; payroll platforms, retail point-of-sale
        systems and government applications used across Mauritius.
      </p>
      <p class="reveal-left reveal-delay-2">
        I hold an MBA in IT Enterprise Management from the University of
        Mauritius, and what drives me is the point where business strategy
        meets technology, which today means putting AI to work on real
        business software. This site is my corner of the web: a profile and a
        small blog about what I learn.
      </p>
      <div class="about-facts reveal-right reveal-delay-2">
        <div class="fact"><span class="fact-key">location</span><span>Mauritius</span></div>
        <div class="fact"><span class="fact-key">role</span><span>Software Developer, Bioculture Group</span></div>
        <div class="fact"><span class="fact-key">stack</span><span>.NET, Angular, SQL</span></div>
        <div class="fact"><span class="fact-key">focus</span><span>AI-assisted delivery</span></div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section container">
    <h2 class="section-title reveal">What I <span class="accent">work with</span></h2>
    <div class="skills-grid">
      {skills.map((skill, i) => (
        <div class={`card reveal-zoom reveal-delay-${Math.min(i, 3)}`}>
          <CardArt kind={skill.art} />
          <h3>{skill.name}</h3>
          <p class="muted">{skill.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- AI in the workflow -->
  <section id="ai-workflow" class="section container">
    <h2 class="section-title reveal">AI in the <span class="accent">workflow</span></h2>
    <p class="ai-intro muted reveal reveal-delay-1">
      AI hasn't replaced the fundamentals; it has compressed the distance
      between an idea and working software. Here's where it earns its place
      in my day:
    </p>
    <div class="ai-steps">
      {aiWorkflow.map((step, i) => (
        <div class={`ai-step reveal reveal-delay-${Math.min(i + 1, 3)}`}>
          <span class="ai-step-num">0{i + 1}</span>
          <h3>{step.title}</h3>
          <p class="muted">{step.note}</p>
        </div>
      ))}
    </div>
    <div class="ai-more reveal reveal-delay-2">
      <a class="btn btn-ghost" href={`${base}/ai/`}>How I use AI <span class="btn-icon" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- Selected projects -->
  <section id="projects" class="section container">
    <h2 class="section-title reveal">Selected <span class="accent">projects</span></h2>
    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class={`card project-card ${i % 2 === 0 ? 'reveal-left' : 'reveal-right'} reveal-delay-${Math.min(i % 2, 3)}`}>
          <CardArt kind={project.art} />
          <span class="project-context muted">{project.context}</span>
          <h3>{project.name}</h3>
          <p class="muted">{project.note}</p>
          <ul class="chip-list" aria-label="Technologies used">
            {project.stack.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Career journey -->
  <section class="section container">
    <h2 class="section-title reveal">My <span class="accent">journey</span></h2>
    <ol class="timeline">
      {journey.map((stop, i) => (
        <li class={`timeline-item reveal-left reveal-delay-${Math.min(i, 2)}`}>
          <div class="timeline-dot" aria-hidden="true"></div>
          <div class="timeline-content">
            <span class="timeline-period muted">{stop.period}</span>
            <h3>{stop.role} · <span class="timeline-org">{stop.org}</span></h3>
            <p class="muted">{stop.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Latest posts -->
  <section class="section container">
    <h2 class="section-title reveal">Latest <span class="accent">writing</span></h2>
    <div class="post-lines">
      {posts.map((post, i) => (
        <a class={`post-line reveal reveal-delay-${Math.min(i, 3)}`} href={`${base}/blog/${post.id}/`}>
          <div>
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.description}</p>
          </div>
          <time class="muted" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Editorial split hero: massive type left, terminal panel right */
  .hero {
    padding: 6rem 0 5rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 4rem;
    align-items: center;
  }

  .eyebrow, .hero-title, .hero-sub, .hero-actions {
    grid-column: 1;
  }

  .hero-title {
    /* Capped so "Praveen Kumar" holds one line in its grid column */
    font-size: clamp(2.7rem, 5.4vw, 4.4rem);
    margin: 1rem 0 1.5rem;
  }

  .hero-sub {
    max-width: 34rem;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
    font-size: 1.12rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Terminal: the hero's image, machined double-bezel */
  .hero-panel {
    grid-column: 2;
    grid-row: 1 / span 4;
    padding: 0.5rem;
    border-radius: calc(var(--radius) + 8px);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.8);
  }

  .terminal {
    background: color-mix(in srgb, var(--bg-soft) 94%, var(--accent));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 6%, transparent);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .terminal-bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border);
  }

  .terminal-bar span:nth-child(1) { background: color-mix(in srgb, #f87171 70%, var(--border)); }
  .terminal-bar span:nth-child(2) { background: color-mix(in srgb, #fbbf24 70%, var(--border)); }
  .terminal-bar span:nth-child(3) { background: color-mix(in srgb, #34d399 70%, var(--border)); }

  .terminal-bar em {
    margin-left: 0.6rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .terminal-body {
    margin: 0;
    padding: 1.35rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 2.05;
    color: var(--text);
  }

  .terminal-body .line {
    display: block;
    white-space: nowrap;
  }

  .terminal-body i {
    font-style: normal;
  }

  .t-p  { color: var(--accent); font-weight: 600; }
  .t-f  { color: var(--accent-2); }
  .t-o  { color: var(--text-muted); }
  .t-ok { color: #34d399; }

  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    margin-left: 0.2ch;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }

  @media (max-width: 60rem) {
    .hero {
      padding-top: 5rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-panel {
      grid-column: 1;
      grid-row: auto;
      margin-top: 3.5rem;
      max-width: 30rem;
    }
  }

  /* Slim stats band under the hero */
  .stats-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 40%, transparent);
  }

  .stats-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }

  .stats-inner dt {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .stats-inner dd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section {
    padding: 5.5rem 0 0;
  }

  .about-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    max-width: 60rem;
  }

  .about-grid p {
    color: var(--text);
  }

  /* Mono facts panel beside the about text */
  .about-facts {
    align-self: start;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 5%, transparent);
    padding: 1.2rem 1.3rem;
    display: grid;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .fact {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .fact-key {
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .fact-key::before {
    content: '> ';
    opacity: 0.6;
  }

  /* AI workflow: numbered step flow on a hairline, no cards */
  .ai-intro {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .ai-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 62rem;
  }

  .ai-step {
    position: relative;
    padding-top: 1.4rem;
  }

  .ai-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border);
  }

  .ai-step::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--accent);
  }

  .ai-step-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .ai-step h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .ai-more {
    margin-top: 2.25rem;
  }

  @media (max-width: 48rem) {
    .ai-steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Career timeline */
  .timeline {
    list-style: none;
    position: relative;
    max-width: 46rem;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.25rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 0.45rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline-item:first-child .timeline-dot {
    background: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin: 0.25rem 0 0.35rem;
  }

  .timeline-org {
    color: var(--accent);
    font-weight: 500;
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-context {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .project-card p {
    flex: 1;
  }

  .skills-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  /* Latest writing: editorial list rows */
  .post-lines {
    max-width: 52rem;
  }

  .post-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 1.4rem 0;
    color: var(--text);
    transition: color 0.35s var(--ease-out);
  }

  .post-line + .post-line {
    border-top: 1px solid var(--border);
  }

  .post-line:hover {
    text-decoration: none;
  }

  .post-line h3 {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    transition: color 0.35s var(--ease-out);
  }

  .post-line:hover h3 {
    color: var(--accent);
  }

  .post-line time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .post-line {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
