---
import Base from '../layouts/Base.astro';
import CardArt from '../components/CardArt.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const skills = [
  { name: 'C# / .NET', note: 'APIs, services and business logic — my core stack since 2007', art: 'code' },
  { name: 'Angular & TypeScript', note: 'Rich, maintainable web front ends', art: 'components' },
  { name: 'SQL Server & Oracle', note: 'Data modelling, queries and reporting', art: 'database' },
  { name: 'Leadership & architecture', note: 'Leading teams, Azure DevOps, designing solutions end-to-end', art: 'team' },
] as const;

const projects = [
  {
    name: 'HR & Payroll platforms',
    context: 'Ceridian · SD Worx',
    note: 'Nine years on large-scale Human Resource & payroll software processing pay for thousands of employees — from senior engineer to lead developer of the team.',
    stack: ['C#', 'SQL Server', 'Azure DevOps'],
    art: 'payroll',
  },
  {
    name: 'Government attendance system',
    context: 'Government of Mauritius',
    note: 'Attendance Record Management System rolled out across government bodies — my first big production system, and still a lesson in building for non-technical users.',
    stack: ['C#', 'ASP.NET', 'Oracle'],
    art: 'attendance',
  },
  {
    name: 'Retail point-of-sale suite',
    context: 'Multi-branch retailer',
    note: 'Desktop tills at the counter, a web back office for stock and reporting — one system keeping every branch in sync.',
    stack: ['C#', 'WinForms', 'ASP.NET'],
    art: 'pos',
  },
  {
    name: 'Business web applications',
    context: 'Bioculture Group',
    note: 'The current chapter: modern web applications supporting the operations of a pioneering biosciences group.',
    stack: ['.NET', 'Angular', 'TypeScript'],
    art: 'bio',
  },
] as const;

const journey = [
  {
    period: '2023 — Present',
    role: 'Software Developer',
    org: 'Bioculture Group',
    note: 'Building business web applications for a pioneering biosciences group in Mauritius.',
  },
  {
    period: '2020 — 2023',
    role: 'Lead Software Developer',
    org: 'SD Worx Mauritius',
    note: 'Led development on HR & payroll software; Azure DevOps and team leadership.',
  },
  {
    period: '2017 — 2019',
    role: 'Solution Architect',
    org: 'Cybernaptics Ltd',
    note: 'Designed solutions end-to-end, including mobile applications.',
  },
  {
    period: '2011 — 2017',
    role: 'Senior Software Engineer',
    org: 'Ceridian',
    note: 'Six years on large-scale Human Resource & Payroll platforms (C#, SQL Server).',
  },
  {
    period: '2010 — 2011',
    role: 'Software Engineer',
    org: 'Keysoft',
    note: 'Point-of-sale system for a multi-branch retailer — desktop front end, web back office.',
  },
  {
    period: '2007 — 2010',
    role: 'Software Engineer',
    org: 'Kisoft',
    note: 'Attendance Record Management System for the Government of Mauritius (C#, ASP.NET, Oracle).',
  },
];
---

<Base title="Praveen Kumar Yennam — Software Developer">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Praveen Kumar Yennam',
      jobTitle: 'Software Developer',
      worksFor: { '@type': 'Organization', name: 'Bioculture Group' },
      address: { '@type': 'PostalAddress', addressCountry: 'MU' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Mauritius' },
      email: 'mailto:praveen@bioculture-mauritius.com',
      url: new URL(import.meta.env.BASE_URL, Astro.site).href,
      sameAs: [
        'https://www.linkedin.com/in/praveen-kumar-yennam-52167910',
        'https://github.com/yennam-praveen',
      ],
    })}
  />
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow reveal visible">Software developer · Bioculture Group · Mauritius</p>
      <h1 class="hero-title reveal visible">
        Praveen Kumar<br /><span class="accent-word">Yennam</span>
      </h1>
      <p class="hero-sub reveal visible reveal-delay-1">
        Software developer with 18+ years of experience building business
        applications in Mauritius — currently at Bioculture Group, with an MBA
        bridging business strategy and technology.
      </p>
      <div class="hero-actions reveal visible reveal-delay-2">
        <a class="btn btn-primary" href={`${base}/blog/`}>Read the blog</a>
        <a class="btn btn-ghost" href="#about">About me</a>
      </div>
      <div class="hero-panel reveal visible reveal-delay-3" aria-hidden="true">
        <span class="hero-chip chip-status">
          <span class="dot-pulse"></span>
          Building at Bioculture Group
        </span>
        <span class="hero-chip chip-years">18+ years shipping software</span>
        <span class="hero-chip chip-mba">MBA · IT Enterprise Management</span>
        <div class="editor">
          <div class="editor-bar">
            <span></span><span></span><span></span>
            <em>developer.cs</em>
          </div>
          <pre class="editor-body"><code><span class="line l1"><i class="tok-k">var</i> dev = <i class="tok-k">new</i> <i class="tok-f">Developer</i>(<i class="tok-s">"Praveen"</i>);</span><span class="line l2">dev.<i class="tok-f">Stack</i>(<i class="tok-s">".NET"</i>, <i class="tok-s">"Angular"</i>, <i class="tok-s">"SQL"</i>);</span><span class="line l3">dev.<i class="tok-f">Location</i>(<i class="tok-s">"Mauritius"</i>);</span><span class="line l4"><i class="tok-k">await</i> dev.<i class="tok-f">Build</i>(<i class="tok-c">/* great software */</i>);<i class="caret"></i></span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section container">
    <h2 class="section-title reveal">About <span class="accent">me</span></h2>
    <div class="about-grid">
      <p class="reveal-left reveal-delay-1">
        I'm a software developer at Bioculture Group in Mauritius. Over the
        last 18+ years I've worked as an engineer, solution architect and lead
        developer — building HR &amp; payroll platforms, retail point-of-sale
        systems and government applications used across Mauritius.
      </p>
      <p class="reveal-right reveal-delay-2">
        I hold an MBA in IT Enterprise Management from the University of
        Mauritius, and what drives me is the point where business strategy
        meets technology. This site is my corner of the web: a home for my
        profile and a small blog where I write occasionally about what I learn.
      </p>
      <div class="about-art reveal-zoom reveal-delay-2" aria-hidden="true">
        <svg viewBox="0 0 170 110" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 92h146" />
          <rect x="52" y="44" width="52" height="36" rx="4" />
          <path d="M44 92l8-6h52l8 6z" />
          <path class="scr s1" d="M60 54h24" />
          <path class="scr s2" d="M66 62h28" />
          <path class="scr s3" d="M60 70h18" />
          <path d="M124 74h16v9a8 8 0 0 1-16 0z" />
          <path d="M140 77c5 0 5 7 0 7" />
          <path class="steam st1" d="M128 66c-2-3 2-5 0-8" />
          <path class="steam st2" d="M136 66c-2-3 2-5 0-8" />
          <path d="M22 92l3-10h14l3 10z" />
          <path class="leafy" d="M32 82c0-8-6-12-12-12 2 8 6 11 12 12z" />
          <path class="leafy" d="M32 82c0-10 4-16 12-18-1 10-5 15-12 18z" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section container">
    <h2 class="section-title reveal">What I <span class="accent">work with</span></h2>
    <div class="skills-grid">
      {skills.map((skill, i) => (
        <div class={`card reveal-zoom reveal-delay-${Math.min(i, 3)}`}>
          <CardArt kind={skill.art} />
          <h3>{skill.name}</h3>
          <p class="muted">{skill.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected projects -->
  <section id="projects" class="section container">
    <h2 class="section-title reveal">Selected <span class="accent">projects</span></h2>
    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class={`card project-card ${i % 2 === 0 ? 'reveal-left' : 'reveal-right'} reveal-delay-${Math.min(i % 2, 3)}`}>
          <CardArt kind={project.art} />
          <span class="project-context muted">{project.context}</span>
          <h3>{project.name}</h3>
          <p class="muted">{project.note}</p>
          <ul class="chip-list" aria-label="Technologies used">
            {project.stack.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Career journey -->
  <section class="section container">
    <h2 class="section-title reveal">My <span class="accent">journey</span></h2>
    <ol class="timeline">
      {journey.map((stop, i) => (
        <li class={`timeline-item reveal-left reveal-delay-${Math.min(i, 2)}`}>
          <div class="timeline-dot" aria-hidden="true"></div>
          <div class="timeline-content">
            <span class="timeline-period muted">{stop.period}</span>
            <h3>{stop.role} · <span class="timeline-org">{stop.org}</span></h3>
            <p class="muted">{stop.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Latest posts -->
  <section class="section container">
    <h2 class="section-title reveal">Latest <span class="accent">writing</span></h2>
    <div class="posts-grid">
      {posts.map((post, i) => (
        <a class={`card post-card reveal-zoom reveal-delay-${Math.min(i, 3)}`} href={`${base}/blog/${post.id}/`}>
          <time class="muted" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
          <h3>{post.data.title}</h3>
          <p class="muted">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Editorial, left-aligned hero — the ambient background drifts behind it */
  .hero {
    padding: 7rem 0 6rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3.5rem;
    align-items: center;
    /* Parallax: hero drifts down and fades slightly as you scroll past it */
    translate: 0 calc(var(--scroll-y, 0) * 0.18px);
    opacity: calc(1 - var(--scroll-y, 0) / 900);
  }

  .eyebrow, .hero-title, .hero-sub, .hero-actions {
    grid-column: 1;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    margin: 1rem 0 1.5rem;
  }

  .hero-sub {
    max-width: 36rem;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Animated code editor: the hero's moving image */
  .hero-panel {
    grid-column: 2;
    grid-row: 1 / span 4;
    perspective: 1200px;
    position: relative;
  }

  /* Floating badges around the editor */
  .hero-chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    font-size: 0.8rem;
    white-space: nowrap;
    animation: chip-float 6s ease-in-out infinite alternate;
  }

  .chip-status {
    top: -3.2rem;
    left: -1.5rem;
    border-color: color-mix(in srgb, var(--tint-sage) 45%, var(--border));
  }

  .chip-years {
    bottom: -2.8rem;
    right: -0.5rem;
    border-color: color-mix(in srgb, var(--tint-sand) 45%, var(--border));
    animation-duration: 7.5s;
    animation-direction: alternate-reverse;
  }

  .chip-mba {
    bottom: -2.4rem;
    left: 0.5rem;
    border-color: color-mix(in srgb, var(--tint-mist) 45%, var(--border));
    animation-duration: 5.2s;
    animation-delay: -2s;
  }

  @keyframes chip-float {
    from { translate: 0 -5px; }
    to { translate: 0 5px; }
  }

  .dot-pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); }
    55% { box-shadow: 0 0 0 7px transparent; }
  }

  .editor {
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 24px 60px color-mix(in srgb, #000 25%, transparent);
    transform: rotateY(-6deg) rotateX(2deg);
    transition: transform 0.4s ease;
    animation: editor-float 7s ease-in-out infinite alternate;
  }

  .hero-panel:hover .editor {
    transform: none;
  }

  @keyframes editor-float {
    from { translate: 0 -6px; }
    to { translate: 0 6px; }
  }

  .editor-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .editor-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--border);
  }

  .editor-bar span:nth-child(1) { background: color-mix(in srgb, var(--tint-clay) 75%, var(--border)); }
  .editor-bar span:nth-child(2) { background: color-mix(in srgb, var(--tint-sand) 75%, var(--border)); }
  .editor-bar span:nth-child(3) { background: color-mix(in srgb, var(--tint-sage) 75%, var(--border)); }

  .editor-bar em {
    margin-left: 0.6rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .editor-body {
    margin: 0;
    padding: 1.4rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 2;
    color: var(--text);
  }

  .editor-body .line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: typing 1.1s steps(32, end) forwards;
  }

  .line.l1 { --w: 35ch; animation-delay: 0.5s; }
  .line.l2 { --w: 36ch; animation-delay: 1.8s; }
  .line.l3 { --w: 26ch; animation-delay: 3.1s; }
  .line.l4 { --w: 39ch; animation-delay: 4.2s; }

  @keyframes typing {
    to { width: var(--w); }
  }

  .editor-body i {
    font-style: normal;
  }

  .tok-k { color: var(--tint-mist); }
  .tok-s { color: var(--tint-sand); }
  .tok-f { color: var(--tint-sage); }
  .tok-c { color: var(--text-muted); }

  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    margin-left: 0.2ch;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  @media (max-width: 60rem) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-panel {
      grid-column: 1;
      grid-row: auto;
      margin-top: 4rem;
      margin-bottom: 2.5rem;
      max-width: 30rem;
    }
    .editor {
      transform: none;
    }
    .chip-status {
      top: -2.6rem;
      left: 0;
    }
    .chip-years {
      bottom: -2.4rem;
      right: 0;
    }
    .chip-mba {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editor,
    .hero-chip,
    .dot-pulse,
    .about-art .scr,
    .about-art .steam,
    .about-art .leafy {
      animation: none;
      transform: none;
    }
    .hero-inner {
      translate: none;
      opacity: 1;
    }
    .timeline::before {
      transform: none;
    }
    .editor-body .line {
      animation: none;
      width: auto;
    }
    .caret {
      animation: none;
    }
  }

  .section {
    padding: 4.5rem 0 0;
  }

  .about-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    color: var(--text-muted);
    max-width: 56rem;
  }

  .about-grid p {
    color: var(--text);
  }

  /* Animated desk scene beside the about text */
  .about-art {
    color: color-mix(in srgb, var(--accent) 80%, var(--text));
    align-self: center;
  }

  .about-art svg {
    width: 100%;
    max-width: 17rem;
  }

  .about-art .scr {
    animation: scr-pulse 3.3s ease-in-out infinite;
  }

  .about-art .s2 { animation-delay: 1.1s; }
  .about-art .s3 { animation-delay: 2.2s; }

  @keyframes scr-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .about-art .steam {
    animation: steam-rise 2.8s ease-in-out infinite;
  }

  .about-art .st2 { animation-delay: 1.4s; }

  @keyframes steam-rise {
    0% { opacity: 0; translate: 0 4px; }
    40% { opacity: 0.8; }
    100% { opacity: 0; translate: 0 -7px; }
  }

  .about-art .leafy {
    transform-box: view-box;
    transform-origin: 32px 82px;
    animation: leaf-sway 5.5s ease-in-out infinite alternate;
  }

  @keyframes leaf-sway {
    from { transform: rotate(-3deg); }
    to { transform: rotate(3deg); }
  }

  /* Career timeline */
  .timeline {
    list-style: none;
    position: relative;
    max-width: 46rem;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--accent) 45%, var(--border));
    /* Drawn top-to-bottom as the section scrolls into view */
    transform: scaleY(var(--tl, 0));
    transform-origin: top;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.25rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 0.45rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline-item:first-child .timeline-dot {
    background: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .timeline-period {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin: 0.25rem 0 0.35rem;
  }

  .timeline-org {
    font-style: italic;
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-context {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .project-card p {
    flex: 1;
  }

  .skills-grid,
  .posts-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  .post-card {
    color: var(--text);
  }

  .post-card:hover {
    text-decoration: none;
  }

  .post-card time {
    font-size: 0.85rem;
  }

  .post-card h3 {
    margin: 0.35rem 0;
  }
</style>

<script>
  // Draw the timeline's spine as it scrolls through the viewport.
  const timeline = document.querySelector<HTMLElement>('.timeline');
  if (timeline) {
    const draw = () => {
      const rect = timeline.getBoundingClientRect();
      const progress = (window.innerHeight * 0.85 - rect.top) / rect.height;
      timeline.style.setProperty('--tl', String(Math.min(1, Math.max(0, progress))));
    };
    addEventListener('scroll', draw, { passive: true });
    draw();
  }
</script>
