      <ellipse cx="48" cy="14" rx="26" ry="7" />
      <path d="M22 14v36c0 4 12 7 26 7s26-3 26-7V14" />
      <path d="M22 32c0 4 12 7 26 7s26-3 26-7" />
      <circle class="seq s1" cx="32" cy="26" r="1.8" fill="currentColor" stroke="none" />
      <circle class="seq s2" cx="32" cy="44" r="1.8" fill="currentColor" stroke="none" />
      <circle class="seq s3" cx="40" cy="26" r="1.8" fill="currentColor" stroke="none" />
    </svg>
  )}
  {kind === 'team' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="48" cy="16" r="7" />
