---
// Small animated line-art illustration for cards.
// The stroke colour comes from the card's tint via `.card-art` in global.css.
interface Props {
  kind:
    | 'code'
    | 'components'
    | 'database'
    | 'team'
    | 'payroll'
    | 'attendance'
    | 'pos'
    | 'bio';
}
const { kind } = Astro.props;
---

<div class="card-art" aria-hidden="true">
  {kind === 'code' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="8" width="84" height="48" rx="6" />
      <path d="M6 20h84" />
      <circle cx="14" cy="14" r="1.6" />
      <circle cx="21" cy="14" r="1.6" />
      <circle cx="28" cy="14" r="1.6" />
      <path class="seq s1" d="M16 30h22" />
      <path class="seq s2" d="M22 38h26" />
      <path class="seq s3" d="M16 46h18" />
      <path d="M64 30l-8 8 8 8" />
      <path d="M72 30l8 8-8 8" />
    </svg>
  )}
  {kind === 'components' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="38" y="6" width="20" height="14" rx="4" />
      <path d="M48 20v8M48 28H26m22 0h22M26 28v8m44-8v8" />
      <rect class="seq s1" x="16" y="36" width="20" height="14" rx="4" />
      <rect class="seq s3" x="60" y="36" width="20" height="14" rx="4" />
    </svg>
  )}
  {kind === 'database' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="48" cy="14" rx="26" ry="7" />
      <path d="M22 14v36c0 4 12 7 26 7s26-3 26-7V14" />
      <path d="M22 32c0 4 12 7 26 7s26-3 26-7" />
      <circle class="seq s1" cx="32" cy="26" r="1.8" fill="currentColor" stroke="none" />
      <circle class="seq s2" cx="32" cy="44" r="1.8" fill="currentColor" stroke="none" />
      <circle class="seq s3" cx="40" cy="26" r="1.8" fill="currentColor" stroke="none" />
    </svg>
  )}
  {kind === 'team' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="48" cy="16" r="7" />
      <path d="M38 34a10 10 0 0 1 20 0" />
      <circle class="seq s1" cx="22" cy="30" r="6" />
      <path class="seq s1" d="M13 45a9 9 0 0 1 18 0" />
      <circle class="seq s3" cx="74" cy="30" r="6" />
      <path class="seq s3" d="M65 45a9 9 0 0 1 18 0" />
      <path d="M40 26l-10 2m36-2 10 2" opacity="0.5" />
    </svg>
  )}
  {kind === 'payroll' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M26 6h30l14 14v38H26z" />
      <path d="M56 6v14h14" />
      <path d="M34 30h28M34 38h28M34 46h14" />
      <circle class="seq s2" cx="62" cy="48" r="8" />
      <path class="seq s2" d="M62 44v8m-3-6h6" />
    </svg>
  )}
  {kind === 'attendance' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="36" cy="32" r="20" />
      <path d="M36 14v4M36 46v4M16 32h4M52 32h4" opacity="0.55" />
      <path class="hand" d="M36 32V21" />
      <path d="M36 32l8 4" />
      <path class="seq s2" d="M62 40l7 7 13-13" />
    </svg>
  )}
  {kind === 'pos' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 6h32v46l-5-4-6 4-5-4-5 4-6-4-5 4z" />
      <path d="M40 18h16M40 26h16M40 34h9" />
      <path class="seq s2" d="M40 42h16" />
    </svg>
  )}
  {kind === 'bio' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="6" width="80" height="52" rx="6" />
      <path d="M8 17h80" />
      <circle cx="15" cy="11.5" r="1.5" />
      <circle cx="21" cy="11.5" r="1.5" />
      <path class="leaf" d="M42 50c-7-11-3-23 12-27 6 11 1 23-12 27z" />
      <path class="leaf" d="M54 23 42 50" />
    </svg>
  )}
</div>

<style>
  .card-art svg {
    width: 76px;
    height: auto;
    display: block;
  }

  /* Gentle sequential pulse shared by most kinds */
  .seq {
    animation: art-pulse 3.6s ease-in-out infinite;
  }

  .s2 { animation-delay: 1.2s; }
  .s3 { animation-delay: 2.4s; }

  @keyframes art-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* Clock hand sweeps around its pivot */
  .hand {
    transform-box: view-box;
    transform-origin: 36px 32px;
    animation: art-sweep 12s linear infinite;
  }

  @keyframes art-sweep {
    to { transform: rotate(360deg); }
  }

  /* Leaf sways from its stem */
  .leaf {
    transform-box: view-box;
    transform-origin: 42px 50px;
    animation: art-sway 5s ease-in-out infinite alternate;
  }

  @keyframes art-sway {
    from { transform: rotate(-4deg); }
    to { transform: rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .seq, .hand, .leaf {
      animation: none;
    }
  }
</style>
