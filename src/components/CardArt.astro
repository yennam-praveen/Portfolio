      <circle cx="163" cy="69" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="171" cy="69" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="179" cy="69" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="163" cy="76" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="171" cy="76" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="179" cy="76" r="1.7" fill="currentColor" stroke="none" />
    </svg>
