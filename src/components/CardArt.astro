---
// Card illustrations, tinted via `.card-art` in global.css.
// Skill cards use small icons; project cards get wide pictorial scenes
// (point-of-sale counter, biometric attendance, HR & payroll, animal
// breeding + data dashboard) rendered as full-width "images".
interface Props {
  kind:
    | 'code'
    | 'components'
    | 'database'
    | 'team'
    | 'ai'
    | 'payroll'
    | 'attendance'
    | 'pos'
    | 'bio';
}
const { kind } = Astro.props;
const isScene = ['payroll', 'attendance', 'pos', 'bio'].includes(kind);
---

<div class:list={['card-art', { 'card-art--scene': isScene }]} aria-hidden="true">
  {kind === 'code' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="8" width="84" height="48" rx="6" />
      <path d="M6 20h84" />
      <circle cx="14" cy="14" r="1.6" />
      <circle cx="21" cy="14" r="1.6" />
      <circle cx="28" cy="14" r="1.6" />
      <path class="seq s1" d="M16 30h22" />
      <path class="seq s2" d="M22 38h26" />
      <path class="seq s3" d="M16 46h18" />
      <path d="M64 30l-8 8 8 8" />
      <path d="M72 30l8 8-8 8" />
    </svg>
  )}
  {kind === 'components' && (
    <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="38" y="6" width="20" height="14" rx="4" />
