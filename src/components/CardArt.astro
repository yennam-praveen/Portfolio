      <rect x="36" y="38" width="38" height="34" rx="4" />
      <circle cx="55" cy="55" r="2.6" />
      <path d="M55 48.8a6.2 6.2 0 0 1 6.2 6.2 6.2 6.2 0 0 1-6.2 6.2" />
      <path d="M55 45a10 10 0 1 0 0 20" />
      <circle cx="131" cy="28" r="15" />
      <path d="M131 14.5v3M131 38.5v3M116.5 28h3M142.5 28h3" opacity="0.55" />
