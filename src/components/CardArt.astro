      <path d="M102 42h16M102 50h16M102 58h10" opacity="0.6" />
      <path d="M160 34v-9a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v9" />
      <rect x="152" y="34" width="38" height="50" rx="6" />
      <rect x="159" y="42" width="24" height="12" rx="2" />
      <circle cx="163" cy="62" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="171" cy="62" r="1.7" fill="currentColor" stroke="none" />
