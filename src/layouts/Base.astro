---
import '@fontsource-variable/outfit';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Set for blog posts: switches Open Graph to article and emits publish date. */
  pubDate?: Date;
}

const { title, description = 'Personal site and blog of Praveen Kumar Yennam, software developer.', pubDate } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isBlog = currentPath.startsWith(`${base}/blog`);
// Trailing slash matters: GitHub Pages redirects /Portfolio to /Portfolio/,
// and the sitemap lists the slashed form — the canonical must match it.
const canonical = new URL(currentPath.endsWith('/') ? currentPath : `${currentPath}/`, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Praveen Kumar Yennam — Blog" href={`${base}/rss.xml`} />
    <title>{title}</title>
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Praveen Kumar Yennam" />
    <meta property="og:locale" content="en_US" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true">
      <span class="glow glow-a"></span>
      <span class="glow glow-b"></span>
    </div>
    <header class="site-header">
      <div class="container">
        <a class="logo" href={`${base}/`}>praveen<span class="dot">.</span>dev</a>
        <nav class="site-nav">
          <a href={`${base}/`} aria-current={!isBlog ? 'page' : undefined}>Home</a>
          <a href={`${base}/#projects`}>Projects</a>
          <a href={`${base}/blog/`} aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <button class="theme-toggle" type="button" aria-label="Switch theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Praveen Kumar Yennam</span>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/praveen-kumar-yennam-52167910" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/yennam-praveen" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:praveen@bioculture-mauritius.com">Email</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </div>
      </div>
    </footer>

    <div class="chat-widget">
      <div class="chat-panel" role="dialog" aria-label="Chat with Praveen's assistant" hidden>
        <div class="chat-header">
          <span class="chat-avatar" aria-hidden="true">PY</span>
          <div>
            <strong>Praveen's assistant</strong>
            <span class="chat-status">replies instantly</span>
          </div>
        </div>
        <div class="chat-messages" aria-live="polite"></div>
        <div class="chat-replies"></div>
      </div>
      <button class="chat-toggle" type="button" aria-expanded="false" aria-label="Open chat">
        <svg class="icon-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <script>
      // Scroll-linked state: progress hairline and header shadow.
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        doc.style.setProperty('--progress', String(max > 0 ? window.scrollY / max : 0));
        header?.classList.toggle('scrolled', window.scrollY > 8);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Theme toggle: flip the data-theme attribute and remember the choice.
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // Chat widget: scripted assistant with quick-reply questions.
      const chatWidget = document.querySelector('.chat-widget')!;
      const chatToggle = chatWidget.querySelector<HTMLButtonElement>('.chat-toggle')!;
      const chatPanel = chatWidget.querySelector<HTMLElement>('.chat-panel')!;
      const chatMessages = chatWidget.querySelector<HTMLElement>('.chat-messages')!;
      const chatReplies = chatWidget.querySelector<HTMLElement>('.chat-replies')!;

      const qa = [
        {
          q: 'What does Praveen do?',
          a: "He's a software developer at Bioculture Group in Mauritius, building business web applications with .NET and Angular.",
          links: false,
        },
        {
          q: "What's his experience?",
          a: 'Over 18 years across HR & payroll platforms, government systems and retail point-of-sale — from engineer to lead developer and solution architect, with an MBA in IT Enterprise Management.',
          links: false,
        },
        {
          q: 'Which technologies?',
          a: 'C# / .NET, Angular & TypeScript, SQL Server and Oracle — with Azure DevOps for delivery.',
          links: false,
        },
        {
          q: 'How do I get in touch?',
          a: 'Email is the quickest way — or connect on LinkedIn:',
          links: true,
        },
      ];

      const addMsg = (text: string, who: 'bot' | 'user') => {
        const el = document.createElement('div');
        el.className = `msg ${who}`;
        el.textContent = text;
        chatMessages.append(el);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return el;
      };

      const addContactLinks = () => {
        const el = document.createElement('div');
        el.className = 'msg bot msg-links';
        const email = document.createElement('a');
        email.href = 'mailto:praveen@bioculture-mauritius.com';
        email.textContent = 'Email';
        const li = document.createElement('a');
        li.href = 'https://www.linkedin.com/in/praveen-kumar-yennam-52167910';
        li.target = '_blank';
        li.rel = 'noopener';
        li.textContent = 'LinkedIn';
        el.append(email, li);
        chatMessages.append(el);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      };

      const showTyping = () => {
        const el = document.createElement('div');
        el.className = 'msg bot typing';
        el.append(...[1, 2, 3].map(() => document.createElement('span')));
        chatMessages.append(el);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return el;
      };

      for (const item of qa) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = item.q;
        btn.addEventListener('click', () => {
          addMsg(item.q, 'user');
          const typing = showTyping();
          setTimeout(() => {
            typing.remove();
            addMsg(item.a, 'bot');
            if (item.links) addContactLinks();
          }, 700);
        });
        chatReplies.append(btn);
      }

      let greeted = false;
      const setChatOpen = (open: boolean) => {
        chatPanel.hidden = !open;
        chatWidget.classList.toggle('open', open);
        chatToggle.setAttribute('aria-expanded', String(open));
        chatToggle.setAttribute('aria-label', open ? 'Close chat' : 'Open chat');
        if (open && !greeted) {
          greeted = true;
          const typing = showTyping();
          setTimeout(() => {
            typing.remove();
            addMsg("Hi, I'm Praveen's site assistant. Pick a question below and I'll fill you in.", 'bot');
          }, 600);
        }
      };

      chatToggle.addEventListener('click', () => setChatOpen(chatPanel.hidden));
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !chatPanel.hidden) setChatOpen(false);
      });
    </script>
  </body>
</html>
